# Copie para `.env.local` (não versionado). Variáveis VITE_ vão para o navegador: só valores públicos.
VITE_SUPABASE_URL=https://<projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=<chave anon pública>
VITE_SUPPORT_EMAIL=
# ID do Pixel do Meta (público). Sem ele, Pixel e aviso de cookies de marketing ficam inativos.
VITE_META_PIXEL_ID=

# Somente servidor (Vercel → Settings → Environment Variables). Nunca use prefixo VITE_.
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<segredo>
APP_URL=http://localhost:5173
ASAAS_ENV=sandbox
ASAAS_API_KEY=<segredo $aact_hmlg_...>
ASAAS_WEBHOOK_TOKEN=<segredo exclusivo do webhook>
# Produção exige as duas variáveis abaixo, apenas após homologação autorizada.
# ASAAS_ENV=production
# ASAAS_ALLOW_PRODUCTION=true
ASAAS_CHECKOUT_MINUTES=60
# Novas compras vitalícias: crie primeiro produto único de R$ 39,90 e oferta na Cakto.
# IDs públicos da conta Cakto; confira o ID interno da oferta antes de ativar.
# CAKTO_PRODUCT_ID=eab775e9-b5c9-4f22-8bcb-490e8338b66e
# CAKTO_OFFER_ID=xjg2gb9
# CAKTO_CHECKOUT_SLUG=xjg2gb9_1253369
# CAKTO_WEBHOOK_SECRET=<segredo do webhook>
# E-mails de boas-vindas: escolha Resend ou Gmail SMTP. Sem configuração, nada é enviado.
# RESEND_API_KEY=<segredo re_...>
# EMAIL_FROM=Voxelia <boas-vindas@seudominio.com.br>
# Para Gmail, ative a verificação em duas etapas e crie uma senha de app (não use a senha da conta).
# GMAIL_SMTP_USER=voce@gmail.com
# GMAIL_SMTP_APP_PASSWORD=<senha de app do Google>

# Desenvolvimento local sem Supabase: libera /app sem login (ignorado na Vercel e em produção).
# BT_DEV_BYPASS=1

# API de Conversões do Meta (servidor). Token é segredo: nunca com prefixo VITE_.
# META_CAPI_TOKEN=<token gerado no Gerenciador de Eventos>
# META_TEST_EVENT_CODE=<opcional, ex.: TEST12345, só para testar no Gerenciador de Eventos>
# Leitura do Gerenciador de Anúncios (token separado da API de Conversões).
# META_ADS_TOKEN=<token de usuário do sistema com ads_read>
# META_AD_ACCOUNT_ID=3796660790508267
# Reels orgânicos da conta profissional @voxelia.ia. O painel tenta META_ADS_TOKEN e descobre a conta pela Página.
# Esse token também precisa de pages_show_list, instagram_basic e instagram_manage_insights.
# As variáveis abaixo são alternativas caso a conta use um token separado ou ID explícito.
# META_INSTAGRAM_TOKEN=<token de acesso à conta profissional>
# META_INSTAGRAM_USER_ID=<ID numérico da conta profissional no Graph API>
